{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install --include=dev --legacy-peer-deps",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ssvvuuysgxyqvmovrlvk.supabase.co/functions/v1/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
