{
  "buildCommand": "npm run build && cp -r frontend/dist public",
  "outputDirectory": "public",
  "installCommand": "npm run install:all",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ssvvuuysgxyqvmovrlvk.supabase.co/functions/v1/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ]
}
