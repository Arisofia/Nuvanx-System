# Frontend environment variables (Vite)
# Copy this file to .env.local and set real values outside version control.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Meta & Ads configuration
# Meta ad-account IDs are intentionally NOT build-time variables. The frontend
# resolves them from the connected canonical `meta_ads` integration at runtime.
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ACCOUNT_IDS=

# Tracking & Asset Identifiers
VITE_META_APP_ID=
VITE_META_PAGE_ID=
VITE_META_INSTAGRAM_CHAMBERI_ID=
VITE_META_INSTAGRAM_GOYA_ID=
VITE_META_BUSINESS_PORTFOLIO_NUVANX_ID=
VITE_META_BUSINESS_PORTFOLIO_YOLANDA_ID=
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=
VITE_WHATSAPP_PHONE=
VITE_WHATSAPP_MESSAGE=
# Fail closed. Set true only after controlled Meta Test WABA + webhook acceptance.
VITE_WHATSAPP_DIRECT_ENABLED=false
VITE_CALENDAR_URL=
VITE_DOCTORALIA_URL=
VITE_LANDING_URL_PRIMARY=
VITE_LANDING_URL_SECONDARY=
VITE_SENTRY_DSN=
