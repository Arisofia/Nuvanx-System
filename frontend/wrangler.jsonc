{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nuvanx-frontend",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.nuvanx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
